# Server-side only. Put your real key in .env, never in dist/.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_TIMEOUT_MS=180000

# Image model must support edits and transparent PNG output.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Server-side address of the product extraction backend.
BACKEND_URL=http://127.0.0.1:4000
